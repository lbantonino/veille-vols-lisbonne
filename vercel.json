{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "site",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude)data'",
  "functions": { "api/*.js": { "includeFiles": "src/**" } },
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }]
}
